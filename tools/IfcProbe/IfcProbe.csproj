<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <Nullable>disable</Nullable>
    <AssemblyName>IfcProbe</AssemblyName>
    <RootNamespace>IfcProbe</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Directory.Build.props collapses the output path for the add-in projects, which place
         themselves per Revit version. Here both target frameworks would land in one folder and
         overwrite each other, so put the framework back into the path. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xbim.Essentials" Version="6.0.*" />
  </ItemGroup>
</Project>
